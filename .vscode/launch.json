{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open SAGIPBRO on localhost",
            "url": "http://localhost:${input:serverPort}",
            "webRoot": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "serverPort",
            "type": "promptString",
            "description": "Port used by the PHP development server",
            "default": "3000"
        }
    ]
}
